# JasonOS — local environment
# Copy to .env.local and fill in. Never commit real secrets.

# ---------- Supabase (shared with CoSA, but jasonos schema) ----------
# CoSA's existing Supabase project. Same URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://vtxbdyqpmwtzijqlzvtc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never ship to the browser.
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Vercel AI Gateway ----------
# On Vercel deploys this is auto-injected via OIDC; only needed for local dev.
# Get one at https://vercel.com/dashboard → AI → API Keys
AI_GATEWAY_API_KEY=

# ---------- Anthropic (direct — preferred) ----------
# Used by Resume Customizer, Post Master, Tell Claude, BNA, drafts, etc.
# When set, JasonOS calls Anthropic directly and does NOT need Vercel AI
# Gateway credits (Gateway still requires a balance even for BYOK).
# Dashboard → API Keys: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Swap models without a code change (default in code: claude-sonnet-4-6;
# Post Master historically used claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5


# ---------- Gmail deep links ----------
# The mailbox the Morning Brief / sync read from. Used to build Gmail thread
# links as /mail/u/<email>/#all/<id> so they open the specific email in the
# right account (avoids the multi-account `u/0` wrong-mailbox problem).
# Defaults to jason@kupermanadvisors.com if unset. NEXT_PUBLIC_ variant lets
# the browser normalize publisher-authored links too.
GMAIL_ACCOUNT_EMAIL=
NEXT_PUBLIC_GMAIL_ACCOUNT_EMAIL=
# Gmail folder (label) Job Alerts harvests from. Leave unset to auto-detect
# a label whose name looks like "Job Alerts". Set this to the exact folder
# name if auto-detect picks the wrong one (nested folders: Parent/Child).
GMAIL_JOB_ALERTS_LABEL=

# ---------- Beeper Desktop (text / IM sync into Outreach) ----------
# Create a token in Beeper Desktop → Settings → Integrations → Approved connections.
# JasonOS Sync calls the Desktop API; when Beeper isn't open (or unreachable),
# Sync soft-skips with "No Beeper data synced".
BEEPER_ACCESS_TOKEN=
# Optional. Defaults to http://127.0.0.1:23373 (only works when Next runs on
# the same machine as Beeper). On Vercel, point this at a Cloudflare / Tailscale
# tunnel with Beeper Remote Access enabled.
# BEEPER_DESKTOP_BASE_URL=https://your-tunnel.example

# ---------- Integrations (wire as modules come online) ----------
HUBSPOT_ACCESS_TOKEN=
INSTANTLY_API_KEY=
# Stripe — Kuperman Advisors + Refactor Sprint revenue, invoicing
STRIPE_SECRET_KEY=
# Lemon Squeezy — gtmtools.io subscriptions, MRR, trial conversions, churn
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
TAPLIO_API_KEY=
LEADDELTA_API_KEY=
MERCURY_API_TOKEN=
VERCEL_ANALYTICS_TOKEN=
# Vercel Web Analytics (home-page site traffic). Team ID + one project ID per site.
VERCEL_TEAM_ID=
VERCEL_PROJECT_GTMTOOLS=
VERCEL_PROJECT_HEAVENLY=
VERCEL_PROJECT_ENCOREOS=
