# Same Supabase project as JasonOS. Server only — never prefix the service role with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://vtxbdyqpmwtzijqlzvtc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The college schema must stay listed under Integrations → Data API → Exposed schemas
# so the server client can reach tables. Security comes from service_role-only grants
# and login checks, not from hiding the schema.

# Optional. A free key from https://api.data.gov/signup/ avoids the shared demo limit.
# Without it, lookups still try the public demo key.
COLLEGE_SCORECARD_API_KEY=

# Web search uses the same Vercel AI Gateway setup as JasonOS.
# On Vercel this is automatic. Locally, set AI_GATEWAY_API_KEY or the search step is skipped.
# College Scorecard numbers are still filled either way.
AI_GATEWAY_API_KEY=

# Optional AI model override (defaults to google/gemini-2.5-flash, free-tier on AI Gateway).
# Paid Claude Sonnet needs AI Gateway credits. For a $0 model: poolside/laguna-s-2.1-free
# EXTRACTION_MODEL=google/gemini-2.5-flash
# COLLEGE_AI_MODEL=google/gemini-2.5-flash
