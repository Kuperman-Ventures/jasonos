  "selectivityGuide": [
    {
      "term": "Extreme Reach",
      "meaning": "Very hard to get into, even for outstanding students"
    },
    {
      "term": "Reach",
      "meaning": "Kyle can be a serious applicant, but admission is still difficult"
    },
    {
      "term": "High Target",
      "meaning": "Kyle appears well matched academically, but admission is quite competitive"
    },
    {
      "term": "Target",
      "meaning": "Kyle’s profile compares favorably with many admitted students"
    },
    {
      "term": "Likely",
      "meaning": "Kyle’s academic credentials are stronger than many students typically admitted"
    }
  ]
}
